# ─── Axis' Iliad API — Environment Variables ───────────────
# Copy this file to .env and customize as needed.
#
# Platform notes:
#   Render  — set via render.yaml envVars or Render dashboard
#   Docker  — pass via docker-compose.yml environment block
#   Local   — copy to .env in project root

# HTTP listen port
# (default: 4000)
PORT=4000

# Runtime environment (development | production | test)
# (default: development)
NODE_ENV=development

# PostgreSQL connection string (Neon). Required at runtime — the data layer fails fast in production if unset.
# (default: "")
DATABASE_URL=

# Log verbosity (debug | info | warn | error)
# (default: info)
LOG_LEVEL=info

# Allowed CORS origin (* for dev, auto-restricts to production domain when NODE_ENV=production)
# (default: *)
CORS_ORIGIN=*

# Rate limit sliding window in ms
# (default: 60000)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per window (anonymous)
# (default: 60)
RATE_LIMIT_MAX_REQUESTS=60

# Max requests per window (authenticated)
# (default: 120)
RATE_LIMIT_MAX_AUTHENTICATED=120

# Number of trusted reverse proxies in front of this service (Render fronts it with one LB). Used to pick the correct rightmost X-Forwarded-For entry as the real client IP for rate limiting.
# (default: 1)
TRUSTED_PROXY_HOPS=1

# Graceful shutdown drain timeout in ms
# (default: 10000)
SHUTDOWN_TIMEOUT_MS=10000

# Per-request timeout in ms (0 = no limit)
# (default: 120000)
REQUEST_TIMEOUT_MS=120000

# Maximum request body size in bytes (default 50MB)
# (default: 52428800)
MAX_BODY_BYTES=52428800

# HTTP keep-alive timeout in ms (must exceed LB idle timeout)
# (default: 65000)
KEEP_ALIVE_TIMEOUT_MS=65000

# API key that grants access to /v1/admin/* endpoints. If unset, admin endpoints return 403.
# (default: "")
ADMIN_API_KEY=

# Stripe secret API key for checkout and subscription management
# (default: "")
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...) for Stripe-Signature verification
# (default: "")
STRIPE_WEBHOOK_SECRET=

# Stripe price ID for the Starter ($29/mo) plan
# (default: "")
STRIPE_PRICE_ID_STARTER=

# Stripe price ID for the Starter ($278.40/yr) plan
# (default: "")
STRIPE_PRICE_ID_STARTER_ANNUAL=

# Stripe price ID for the Pro ($99/mo) plan
# (default: "")
STRIPE_PRICE_ID_PRO=

# Stripe price ID for the Pro ($950.40/yr) plan
# (default: "")
STRIPE_PRICE_ID_PRO_ANNUAL=

# Stripe price ID for the Growth ($299/mo) plan
# (default: "")
STRIPE_PRICE_ID_GROWTH=

# Stripe price ID for the Growth ($2,870.40/yr) plan
# (default: "")
STRIPE_PRICE_ID_GROWTH_ANNUAL=

# Legacy Stripe price ID alias for Starter
# (default: "")
STRIPE_PRICE_ID_PAID=

# Legacy Stripe price ID alias for Starter annual
# (default: "")
STRIPE_PRICE_ID_PAID_ANNUAL=

# Legacy Stripe price ID alias for Growth
# (default: "")
STRIPE_PRICE_ID_SUITE=

# API key for the OPTIONAL Firecrawl web-research proxy backend (https://firecrawl.dev). Only consulted when AXIS_WEB_RESEARCH_BACKEND=firecrawl — the default AXIS-owned sovereign backend needs no key.
# (default: "")
FIRECRAWL_API_KEY=

# Web research backend selector: `sovereign` (default — AXIS-owned fetch+extract+crawl, no third-party key) or `firecrawl` (optional legacy proxy; requires FIRECRAWL_API_KEY, without which the tools return a structured `_not_configured` envelope).
# (default: sovereign)
AXIS_WEB_RESEARCH_BACKEND=sovereign

# User-Agent the sovereign crawler presents on every fetch (also matched against robots.txt User-agent groups). Defaults to the AxisIliadBot UA.
# (default: "")
AXIS_WEB_RESEARCH_USER_AGENT=

# Per-document byte cap for the sovereign fetcher (default 5 MiB). Larger bodies are truncated and flagged truncated:true in metadata.
# (default: 5242880)
AXIS_WEB_RESEARCH_MAX_BYTES=5242880

# Total timeout in ms for one sovereign fetch including all redirect hops and body read (default 30000).
# (default: 30000)
AXIS_WEB_RESEARCH_TIMEOUT_MS=30000

# Minimum delay in ms between successive sovereign fetches to the same host (default 1000). A larger robots.txt Crawl-delay is honored over this floor.
# (default: 1000)
AXIS_WEB_RESEARCH_POLITENESS_MS=1000

# Dev/test escape hatch ONLY: 1/true disables the sovereign fetcher's SSRF address+port checks so hermetic tests can fetch 127.0.0.1 fixtures. The http/https scheme allowlist still applies. NEVER set in production.
# (default: "")
AXIS_WEB_RESEARCH_ALLOW_PRIVATE_HOSTS=

# API token for Replicate image/video generation (https://replicate.com)
# (default: "")
REPLICATE_API_TOKEN=

# API key for Fastio persistent storage and RAG (https://fast.io)
# (default: "")
FASTIO_API_KEY=

# API key for Resend email delivery (https://resend.com). Used by the internal welcome/upgrade/usage-alert pipeline in @axis/snapshots and by the agent-facing iliad_transactional_email MCP tool (proxy mode).
# (default: "")
RESEND_API_KEY=

# Verified Resend sender address used as the From: header for iliad_transactional_email. Must be a domain you've verified in the Resend dashboard. When unset, iliad_transactional_email returns a structured _not_configured envelope.
# (default: "")
RESEND_FROM_ADDRESS=

# GitHub OAuth App client ID for web login (GET /v1/auth/github).
# (default: "")
GITHUB_CLIENT_ID=

# GitHub OAuth App client secret. Required alongside GITHUB_CLIENT_ID for the callback token exchange.
# (default: "")
GITHUB_CLIENT_SECRET=

# GitHub OAuth redirect URI. Must byte-match the URI registered in the GitHub OAuth App.
# (default: http://localhost:4000/v1/auth/github/callback)
GITHUB_CALLBACK_URL=http://localhost:4000/v1/auth/github/callback

# Google OAuth 2.0 client ID for web login (GET /v1/auth/google).
# (default: "")
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 client secret. Required alongside GOOGLE_CLIENT_ID for the callback token exchange.
# (default: "")
GOOGLE_CLIENT_SECRET=

# Google OAuth redirect URI. Must byte-match the Authorized redirect URI in Google Cloud Console, or the token exchange fails with redirect_uri_mismatch.
# (default: http://localhost:4000/v1/auth/google/callback)
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# Rollout gate for the PAI'D Fabric-Credit wallet (MCP tokens-out): off (default, no wallet calls) | read (surface balance) | shadow (log would-be debits) | enforce (debit + 402 top-up). Advance only after dogfooding live PAI'D.
# (default: off)
PAID_WALLET_MODE=off

# Shared secret from the GitHub App settings. Verifies X-Hub-Signature-256 on POST /v1/github/webhook. If unset, the endpoint returns 503 so the App retries until ops finishes the deploy.
# (default: "")
GITHUB_WEBHOOK_SECRET=

# Personal-access token fallback used when fetching tarballs for webhook-triggered snapshots and the /v1/github/analyze handler when no per-account token is stored.
# (default: "")
GITHUB_TOKEN=

# Embeddings backend selector for iliad_embeddings: `local` (default — AXIS-owned in-process inference via node-llama-cpp with an embedding-capable GGUF; no upstream HTTP call) or `openai` (optional legacy proxy; requires OPENAI_API_KEY).
# (default: local)
AXIS_EMBEDDING_BACKEND=local

# Path to an embedding-capable GGUF model (e.g. bge-small-en-v1.5 Q4_K_M, ~130MB, MIT) for the local backend. Defaults to models/bge-small-en-v1.5-q4_k_m.gguf at process.cwd(). Until the file is present, iliad_embeddings returns a structured `_not_configured: true` envelope (backend: local) — same operator gate as AXIS_LLM_MODEL_PATH for iliad_llm_inference.
# (default: "")
AXIS_EMBEDDING_MODEL_PATH=

# OpenAI API key. Optional: only consulted when AXIS_EMBEDDING_BACKEND=openai selects the legacy embeddings proxy. When that backend is selected and this is unset, iliad_embeddings returns a structured `_not_configured: true` envelope listing the missing env var so callers can branch without parsing free text.
# (default: "")
OPENAI_API_KEY=

# OpenAI embedding model used by iliad_embeddings when AXIS_EMBEDDING_BACKEND=openai. Defaults to text-embedding-3-small. Override to text-embedding-3-large or any compatible model on a per-deploy basis. Ignored on the default local backend.
# (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Visa-issued Token Requestor ID for direct VTS (Visa Token Service) provisioning via iliad_network_tokenization. Requires Visa network onboarding — cannot be obtained by code. Unset ⇒ provider 'vts' returns a structured `_not_configured: true` envelope (the Stripe read adapter stays live via STRIPE_SECRET_KEY).
# (default: "")
AXIS_VTS_TOKEN_REQUESTOR_ID=

# Mastercard-issued Token Requestor ID for direct MDES (Mastercard Digital Enablement Service) provisioning via iliad_network_tokenization. Requires Mastercard network onboarding. Unset ⇒ provider 'mdes' returns a structured `_not_configured: true` envelope.
# (default: "")
AXIS_MDES_TOKEN_REQUESTOR_ID=

# Cloudflare account ID; forms part of the R2 host (<account>.r2.cloudflarestorage.com). All four R2_* vars must be set for iliad_object_storage to issue signed URLs; otherwise the tool returns a structured `not_configured` envelope.
# (default: "")
R2_ACCOUNT_ID=

# R2 API token access key. Use the 'Object Read & Write' template scoped to a single bucket so a compromised key cannot escalate.
# (default: "")
R2_ACCESS_KEY_ID=

# R2 API token secret key (treat as a password). Pairs with R2_ACCESS_KEY_ID.
# (default: "")
R2_SECRET_ACCESS_KEY=

# Bucket name iliad_object_storage signs URLs against. Keys inside the bucket are prefixed with accounts/<account_id>/ for per-tenant isolation.
# (default: "")
R2_BUCKET=

# Slack/webhook URL the alerting evaluator posts to. Unset ⇒ startAlerting() no-ops entirely (no timer, no evaluation) — alerting is opt-in.
# (default: "")
ALERT_WEBHOOK_URL=

# How often the alert evaluator checks thresholds. Floored at 10000ms regardless of a lower override.
# (default: 60000)
ALERT_EVAL_INTERVAL_MS=60000

# Minimum gap between repeat alerts for the same condition, to avoid paging on every evaluation while a problem persists.
# (default: 900000)
ALERT_REALERT_MS=900000

# Error-rate percentage threshold that triggers an alert.
# (default: 5)
ALERT_ERROR_RATE_PCT=5

# Minimum request sample size before the error-rate threshold is evaluated, so a handful of early failures can't page on statistically meaningless data.
# (default: 20)
ALERT_MIN_SAMPLE=20

# Deny-by-default gate on self-serve tier/credit changes (POST /v1/account/tier and similar). Production leaves this false — upgrades must go through PAI'D checkout; flipping it true re-enables the self-serve path, mainly for local/staging testing.
# (default: false)
AXIS_ALLOW_SELF_SERVE_ENTITLEMENTS=false

# Feature flag: turns an anonymous caller's auth error into a provisioning-challenge response instead of a plain 401. Default off.
# (default: false)
AXIS_ANON_PROVISION_FRONTDOOR=false

# H1: collect payment in-band on the MCP tool-call surface (an over-quota agent's 402 can be settled via an X-Payment retry on the same call). Degrades to the existing 402-negotiation error if the payment rail isn't configured.
# (default: true)
AXIS_MCP_INBAND_SETTLEMENT=true

# Enables the payment-capability self-probe path in mcp-tool-impls.ts. Set to "false" to disable it.
# (default: true)
AXIS_PAYMENT_PROBE_ENABLED=true

# Set to "1" to force iliad_code_sandbox off (returns not-configured) even if Docker is reachable — an operator kill switch independent of Docker availability.
# (default: "")
AXIS_CODE_SANDBOX_DISABLED=

# Docker image used to run submitted code in iliad_code_sandbox. Falls back to the tool's built-in default image when unset.
# (default: "")
AXIS_CODE_SANDBOX_IMAGE=

# Aggregate cap on concurrent sandbox runs across all callers — each run reserves host memory/CPU, so this bounds worst-case resource exhaustion.
# (default: 4)
AXIS_SANDBOX_MAX_CONCURRENT=4

# Path to a local GGUF chat model for iliad_llm_inference. Until set and the file exists, the tool returns a structured `_not_configured: true` envelope.
# (default: "")
AXIS_LLM_MODEL_PATH=

# Path to the Piper text-to-speech CLI binary used by the local TTS backend. Unset ⇒ the tool reports not-configured rather than failing a spawn.
# (default: "")
AXIS_PIPER_CLI_PATH=

# Directory containing Piper voice model files. Paired with AXIS_PIPER_CLI_PATH.
# (default: "")
AXIS_PIPER_VOICE_DIR=

# Default Piper voice name used when a text-to-speech call doesn't specify one.
# (default: "")
AXIS_PIPER_DEFAULT_VOICE=

# Path to the Whisper speech-to-text CLI binary used by the local STT backend. Unset ⇒ the tool reports not-configured rather than failing a spawn.
# (default: "")
AXIS_WHISPER_CLI_PATH=

# Path to a local Whisper model file. Paired with AXIS_WHISPER_CLI_PATH.
# (default: "")
AXIS_WHISPER_MODEL_PATH=

# Request body size (bytes) up to which an oversized /v1/analyze request stays free before the size-scaled surcharge kicks in.
# (default: "")
AXIS_LARGE_BODY_FREE_CAP_BYTES=

# Absolute request body size ceiling (bytes) above which a request is rejected outright regardless of willingness to pay the surcharge.
# (default: "")
AXIS_LARGE_BODY_HARD_CEILING_BYTES=

# HMAC secret binding MPP payment challenges to this server instance. Generate once and keep stable in production — rotating it invalidates in-flight challenges.
# (default: "")
MPP_SECRET_KEY=

# Hex 0x address that receives Tempo/USDC on-chain payments. Enables the crypto payment rail in MPP negotiation when set; the rail is omitted from accepted_payment_schemes otherwise.
# (default: "")
TEMPO_RECIPIENT_ADDRESS=

# Set to "true" to point Tempo/USDC settlement at the testnet contract address instead of mainnet.
# (default: false)
TEMPO_TESTNET=false

# RSA private key (PEM) for signing MCP OAuth2 access tokens. Takes precedence over private-key.pem on disk. Falls back to an ephemeral generated keypair if unset — every restart then invalidates previously issued tokens, so this should be set in production (see R0.2).
# (default: "")
JWT_PRIVATE_KEY=

# RSA public key (PEM) matching JWT_PRIVATE_KEY, used to verify MCP OAuth2 tokens and serve the JWKS endpoint.
# (default: "")
JWT_PUBLIC_KEY=

# Configured signing key for attestation responses. A present-but-malformed value is treated as an operator error (fails loudly) rather than silently falling back. Unset ⇒ a per-process ephemeral key is used, which does not survive a restart.
# (default: "")
AXIS_ATTESTATION_PRIVATE_KEY=

# Base URL of the web dashboard, used to build redirect/callback links (OAuth login return, credit-pack purchase links) when a more specific override isn't set.
# (default: http://localhost:3000)
AXIS_WEB_URL=http://localhost:3000

# Preferred public URL for PAI'D-facing redirect links; checked before falling back to AXIS_WEB_URL.
# (default: "")
PAID_PUBLIC_APP_URL=

# Comma-separated list of account IDs treated as PAI'D wallet owners for cashier/settlement purposes.
# (default: "")
PAID_WALLET_OWNER_ACCOUNT_IDS=

# Set automatically by the vitest test runner (not meant to be set manually). Gates test-only code paths, e.g. skipping boot migrations and signal-handler registration during tests.
# (default: "")
VITEST=

# When running under vitest (VITEST=true), runtime log output is suppressed by default; set to "1" to re-enable it for debugging a specific test run.
# (default: false)
AXIS_ENABLE_TEST_LOGS=false
