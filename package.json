{
  "name": "axis-iliad",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "Axis' Iliad - one API call that turns any codebase into 144 deterministic AI-agent-ready artifacts (AGENTS.md, CLAUDE.md, design tokens, Visa CE 3.0 compliance kit, MCP configs, and more)",
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "codebase-analysis",
    "artifact-generation",
    "agents-md",
    "claude-md",
    "cursorrules",
    "llm-context",
    "visa-compliance",
    "x402",
    "ap2",
    "agentic-commerce"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lastmanupinc-hub/axis-iliad.git"
  },
  "homepage": "https://axis-api-6c7z.onrender.com",
  "scripts": {
    "dev": "pnpm --filter @axis/api dev",
    "build": "pnpm -r build",
    "test": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "test:ci-mirror": "node scripts/test-ci-mirror.mjs",
    "live-probe": "node scripts/live-probe.mjs",
    "bench": "vitest bench",
    "bench:compliance": "vitest bench packages/generator-core/src/perf.bench.ts",
    "lint": "eslint .",
    "generate-posts": "node scripts/generate-posts.js",
    "post-content": "node scripts/post-content.js",
    "test-webhook": "node scripts/test-webhook-server.js",
    "setup-posting": "node scripts/setup-posting.js",
    "regenerate": "pwsh scripts/regenerate.ps1",
    "regenerate:sh": "bash scripts/regenerate.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.7.0",
    "happy-dom": "^20.9.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "vite@^8": "^8.0.16",
      "ws": "^8.21.0",
      "postcss": "^8.5.10"
    }
  }
}
