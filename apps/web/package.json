{
  "name": "@axis/web",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run seo:prerender && npm run seo:audit",
    "preview": "vite preview",
    "seo:prerender": "node scripts/seo-prerender.mjs dist --routes seo.routes.ts --wait 4000",
    "seo:audit": "node scripts/seo-audit.mjs dist"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~5.7.0",
    "vite": "^8.0.16"
  }
}